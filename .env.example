# Copy this file to .env and fill in your own values.
# These come from your app registration on https://aps.autodesk.com (My Apps).

APS_CLIENT_ID=your-aps-client-id-here
APS_CLIENT_SECRET=your-aps-client-secret-here
# Must exactly match the callback URL registered for your app.
APS_CALLBACK_URL=http://localhost:3000/auth/callback

# Session cookie signing secret — any random string for local dev.
SESSION_SECRET=change-this-to-something-lol

# From your Supabase project's Settings → API.
# SUPABASE_SERVICE_ROLE_KEY is the *service role* key, not the anon/public
# key — it bypasses Row Level Security, so keep it secret and server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

PORT=3000
